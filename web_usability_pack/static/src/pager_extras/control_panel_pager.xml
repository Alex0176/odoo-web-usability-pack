<templates xml:space="preserve">

    <!-- enable the extras on the pager of the control panel -->
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_pager')]/Pager" position="attributes">
            <attribute name="wupExtras">'view'</attribute>
        </xpath>
    </t>

</templates>
